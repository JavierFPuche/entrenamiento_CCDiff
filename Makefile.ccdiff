USER_NAME := $(shell whoami)
TAG_NAME := v1
IMAGE_NAME := ccdiff_train

UID := $(shell id -u)
GID := $(shell id -g)

# Misma estructura que en el DGX, para probar en tu PC (RTX 4090):
#   PROYECTO/                      -> /workspace
#     datasets/nuscenes/           (pon aqui nuScenes si quieres entrenar en local)
#     datasets/trajdata_cache/  entrenados/  pruebas/  entornos/home/
#   esta carpeta (el repositorio)  -> /workspace/scripts
PROYECTO := $(abspath $(CURDIR)/../VLM_ACCIDENTES_CCDIFF)

define run_docker
	mkdir -p $(PROYECTO)/datasets/trajdata_cache $(PROYECTO)/entrenados $(PROYECTO)/pruebas $(PROYECTO)/entornos/home
	docker run -it --rm \
		--net host \
		--gpus all \
		--ipc host \
		--ulimit memlock=-1 \
		--ulimit stack=67108864 \
		--name=$(IMAGE_NAME)_container \
		-u $(USER_NAME) \
		-v $(PROYECTO):/workspace \
		-v $(CURDIR):/workspace/scripts \
		'$(IMAGE_NAME)':$(TAG_NAME) \
		/bin/bash -c $(1)
endef

build:
	docker build ./Docker -t '$(IMAGE_NAME)':$(TAG_NAME) --force-rm --build-arg USER=$(USER_NAME) --build-arg UID=$(UID) --build-arg GID=$(GID)

attach:
	docker exec -it $(IMAGE_NAME)_container bash

run:
	$(call run_docker, "bash")

# Prueba rapida en tu PC antes de mandar trabajos al DGX
debug:
	$(call run_docker, "python /workspace/scripts/lanzar_entrenamiento.py --debug --pasos 200")
