USER_NAME := $(shell whoami)
TAG_NAME := v1
IMAGE_NAME := ccdiff_train

UID := $(shell id -u)
GID := $(shell id -g)

# Carpetas locales que se montan (ajusta NUSC a donde tengas nuScenes en el PC)
NUSC := /mnt/secundario/datasets/nuscenes

# Mismos montajes que en el DGX:
#   esta carpeta -> /workspace (lanzador, cache de trajdata y resultados)
#   nuScenes     -> /datos/nuscenes (lanzar_entrenamiento.py cambia ahi las rutas fijas de CCDiff)
define run_docker
	docker run -it --rm \
		--net host \
		--gpus all \
		--ipc host \
		--ulimit memlock=-1 \
		--ulimit stack=67108864 \
		--name=$(IMAGE_NAME)_container \
		-u $(USER_NAME) \
		-v $(CURDIR):/workspace \
		-v $(NUSC):/datos/nuscenes:ro \
		-e HOME=/workspace/home \
		'$(IMAGE_NAME)':$(TAG_NAME) \
		/bin/bash -c $(1)
endef

build:
	docker build ./Docker -t '$(IMAGE_NAME)':$(TAG_NAME) --force-rm --build-arg USER=$(USER_NAME) --build-arg UID=$(UID) --build-arg GID=$(GID)

attach:
	docker exec -it $(IMAGE_NAME)_container bash

run:
	$(call run_docker, "bash")

# Prueba rapida en tu PC (RTX 4090) antes de mandar trabajos al DGX
debug:
	$(call run_docker, "python /workspace/lanzar_entrenamiento.py --debug --pasos 200")
